# ─────────────────────────────────────────────────────────────
#  พุงกลม แคทเทอริ่ง — Environment variables
#  คัดลอกไฟล์นี้เป็น .env.local สำหรับรันในเครื่อง
#  และตั้งค่าเดียวกันใน Vercel → Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# รหัสผ่านสำหรับเข้าหน้าจัดการเนื้อหา /admin  (เปลี่ยนเป็นของคุณเอง!)
ADMIN_PASSWORD=change-me-please

# คีย์ลับสำหรับเซ็นเซสชัน (สุ่มยาว ๆ ก็ได้) — ถ้าไม่ตั้งจะใช้ ADMIN_PASSWORD แทน
ADMIN_SESSION_SECRET=

# Upstash Redis — ที่จัดเก็บเนื้อหาที่แก้ไข (สร้างฟรีที่ https://console.upstash.com)
# ถ้าไม่ตั้งค่า: dev = เก็บลงไฟล์ในเครื่อง, production = อ่านค่าเริ่มต้นอย่างเดียว (แก้ไม่ได้)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
